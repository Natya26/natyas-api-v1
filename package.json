{
    "name": "navarasa-api",
    "version": "1.0.0",
    "description": "API application for navarasa",
    "main": "app.js",
    "scripts": {
        "test": "nyc mocha",
        "dev": "nodemon app.js -e .js,.mjs,.coffee,.litcoffee,.json,.yaml",
        "start": "node app.js",
        "db:migrate": "npm run knex migrate:latest",
        "db:migrate:make": "npm run knex migrate:make",
        "db:migrate:undo": "npm run knex migrate:rollback",
        "db:seed": "npm run knex seed:run",
        "db:seed:make": "npm run knex seed:make",
        "knex": "knex --knexfile modules/db/knexfile.js",
        "document": "apidoc -i modules/ -o doc/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://mohdhashimpa@bitbucket.org/logibidsgsoft/logibids-api.git"
    },
    "author": "Hashim",
    "license": "ISC",
    "homepage": "https://bitbucket.org/logibidsgsoft/logibids-api#readme",
    "dependencies": {
        "@googlemaps/google-maps-services-js": "^3.3.16",
        "amazon-cognito-identity-js": "^3.2.2",
        "apidoc": "^0.53.1",
        "aws-sdk": "^2.637.0",
        "axios": "^1.3.4",
        "bcryptjs": "^2.4.3",
        "body-parser": "^1.19.0",
        "cors": "^2.8.5",
        "crc-32": "^1.2.2",
        "cron": "^1.8.2",
        "crypto-js": "^4.0.0",
        "dotenv": "^8.2.0",
        "ejs": "^3.1.9",
        "express": "^4.17.1",
        "express-validator": "^6.3.1",
        "google-auth-library": "^8.7.0",
        "google-distance-matrix": "^0.0.2",
        "jsesc": "^3.0.2",
        "jsonwebtoken": "^8.5.1",
        "jwk-to-pem": "^2.0.3",
        "knex": "^2.3.0",
        "knx": "^2.5.2",
        "mocha": "^10.1.0",
        "moment": "^2.24.0",
        "multer": "^1.4.2",
        "node-fetch": "^2.6.0",
        "node-schedule": "^2.0.0",
        "nyc": "^15.0.0",
        "objection": "^3.0.1",
        "onesignal-node": "^3.1.5",
        "otpless-node-js-auth-sdk": "^1.0.8",
        "passport": "^0.6.0",
        "pg": "^8.8.0",
