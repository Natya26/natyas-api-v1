        "razorpay": "^2.8.6",
        "request": "^2.88.2",
        "request-promise": "^4.2.5",
        "rewire": "^6.0.0",
        "sinon": "^9.0.0",
        "socket.io": "^2.3.0",
        "stripe": "^11.11.0",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^4.6.0",
        "twilio": "^3.83.4"
    },
    "devDependencies": {
        "eslint": "^6.8.0",
        "eslint-config-google": "^0.14.0",
        "nodemon": "^2.0.22"
    }
}
